# Per-display settings copied to /boot/firmware/tessavision.conf.
#
# Floors may be 1, 2, 3, or 4. Console colors may be black, blue, cyan, green,
# grey, magenta, red, white, or yellow.
TESSAVISION_FLOOR=3
TESSAVISION_HOSTNAME=tessavision
TESSAVISION_FOREGROUND=yellow
TESSAVISION_BACKGROUND=black

# Match the selected NetworkManager profile to the physical Wi-Fi adapter.
# These are profile names, not passwords. See config/ for floor examples.
TESSAVISION_WIFI_DEVICE=wlan0
TESSAVISION_WIFI_CONNECTION=Mox-dongle
